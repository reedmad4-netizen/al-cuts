{
  "name": "clipx-ai",
  "version": "1.7.0",
  "private": true,
  "description": "CLIPX AI — AI-Powered Automatic Gaming Clip Generator (Zero Native Build Tools Required)",
  "scripts": {
    "dev": "node server.mjs --dev",
    "build": "node scripts/run-next.mjs build",
    "start": "node server.mjs --prod",
    "seed:media": "node scripts/generate-sample-media.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "test:s3": "node scripts/test-s3-signer.mjs",
    "test:social": "node scripts/test-instagram-flow.mjs",
    "test:youtube": "node scripts/test-youtube-flow.mjs",
    "desktop": "node desktop/launch.mjs",
    "desktop:check": "node desktop/launch.mjs --check",
    "desktop:selftest": "node desktop/selftest.mjs",
    "desktop:shortcut": "node desktop/install-shortcut.mjs",
    "desktop:dist": "node desktop/dist.mjs",
    "desktop:dist:win": "node desktop/dist.mjs win",
    "desktop:dist:mac": "node desktop/dist.mjs mac",
    "desktop:dist:linux": "node desktop/dist.mjs linux"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "jose": "^5.9.6",
    "lucide-react": "^0.460.0",
    "next": "15.5.29",
    "postcss": "^8.5.33",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.12.0",
    "ws": "^8.18.0",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "autoprefixer": "^10.4.20",
    "aws4": "^1.13.2",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "main": "desktop/electron/main.cjs",
  "build": {
    "appId": "ai.clipx.desktop",
    "productName": "CLIPX AI",
    "copyright": "CLIPX AI",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "desktop/electron/**",
      "desktop/version.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next",
        "to": "app/.next",
        "filter": [
          "**/*",
          "!cache/**"
        ]
      },
      {
        "from": "public/media/clips",
        "to": "app/public/media/clips"
      },
      {
        "from": "public/media/posters",
        "to": "app/public/media/posters"
      },
      {
        "from": "public/media/streams",
        "to": "app/public/media/streams"
      },
      {
        "from": "scripts",
        "to": "app/scripts"
      },
      {
        "from": "server.mjs",
        "to": "app/server.mjs"
      },
      {
        "from": "next.config.mjs",
        "to": "app/next.config.mjs"
      },
      {
        "from": "desktop/runtime/app-package.json",
        "to": "app/runtime-package.json"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png",
      "artifactName": "CLIPX-AI-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.video",
      "artifactName": "CLIPX-AI-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "artifactName": "CLIPX-AI-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "CLIPX AI"
    },
    "asar": false
  },
  "author": {
    "name": "CLIPX AI",
    "email": "noreply@clipx.ai"
  },
  "license": "UNLICENSED"
}
