# Optional configuration for CLIPX AI v1.5.0
# Copy to `.env.local` — the app runs with sensible defaults without it.

# --- Sessions ---------------------------------------------------------------
# HS256 signing key for the HttpOnly session cookie. Must be >= 32 characters.
# If unset, a unique key is generated on first boot at data/auth-secret
# (single-instance convenience only — set this explicitly when scaling out).
CLIPX_AUTH_SECRET=

# Set when the app is served over HTTPS so cookies are issued Secure
CLIPX_PUBLIC_URL=

# Block the shared 1-click demo account on public deployments
CLIPX_DISABLE_DEMO_ACCOUNT=false

# --- Server -----------------------------------------------------------------
PORT=3000

# --- Optional: Supabase Auth & PostgreSQL -----------------------------------
# Run supabase/schema.sql in your Supabase SQL editor first.
# The app runs out-of-the-box with local SQLite when these are omitted.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional: official streaming platform APIs -----------------------------
# Can also be entered in the Settings UI (stored unencrypted in data/clipx.db).
TWITCH_CLIENT_ID=
TWITCH_ACCESS_TOKEN=
YOUTUBE_API_KEY=
KICK_API_TOKEN=

# --- Optional: media binaries -----------------------------------------------
# Both are auto-detected: PATH -> FFMPEG_PATH/FFPROBE_PATH -> bundled
# ffmpeg-static / ffprobe-static. Check /api/health after boot.
FFMPEG_PATH=
FFPROBE_PATH=

# --- Optional: Instagram Reels publishing ------------------------------------
# Get these from the Meta app dashboard (instagram_basic + instagram_content_publish).
# Only Business/Creator accounts linked to a Facebook Page can publish.
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_GRAPH_API_VERSION=v23.0

# --- Optional: S3-compatible media hosting -----------------------------------
# Instagram downloads each Reel from a public URL, so the rendered Short is
# uploaded here first. Works with AWS S3, Cloudflare R2, Backblaze B2, MinIO.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=clipx
# Optional CDN / public bucket base URL. Leave empty to use presigned links.
S3_PUBLIC_BASE_URL=
