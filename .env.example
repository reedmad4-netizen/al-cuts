# Optional: change this secret for production deployments
CLIPX_AUTH_SECRET=replace-with-a-random-32-char-secret

# Optional: Supabase Auth & PostgreSQL (app runs out-of-the-box with local SQLite if omitted)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Official Streaming Platform APIs (can also be added in the Settings UI)
TWITCH_CLIENT_ID=
TWITCH_ACCESS_TOKEN=
YOUTUBE_API_KEY=
KICK_API_TOKEN=
